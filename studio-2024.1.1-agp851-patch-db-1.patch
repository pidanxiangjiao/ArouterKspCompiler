+package android.databinding.ksp
+
+import com.google.devtools.ksp.processing.Resolver;
+import com.google.devtools.ksp.symbol.KSDeclaration;
+
+
+
+object AnnotationUtil {
+
+    /**
+     * Returns only the elements that are annotated with the given class. For some reason
+     * RoundEnvironment is returning elements annotated by other annotations.
+     */
+    fun getElementsAnnotatedWith(
+        resolver: Resolver,
+        annotationQualifiedName: String
+    ): List<KSDeclaration> {
+
+        return resolver.getSymbolsWithAnnotation(annotationQualifiedName)
+            .filterIsInstance<KSDeclaration>()
+            .toList()
+    }
+
+}

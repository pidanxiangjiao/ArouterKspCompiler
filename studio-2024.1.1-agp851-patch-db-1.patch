+private fun JavaCompile.processDataBindingExportClassListFile(
+    file: RegularFileProperty
+) {
+    //TODO ksp
+//    val projectPath = this.project.path
+    doLast {
+        val outJar = file.get().asFile
+        val parentDir = outJar.parentFile
+        val filesInDir = parentDir.listFiles { f -> f.isFile } ?: emptyArray()
+
+        if (filesInDir.size == 1) {
+            val singleFile = filesInDir.first()
+            val targetFile = File(parentDir, "out.jar")
+            val success = singleFile.renameTo(targetFile)
+            if (success) {
+                println("[processDataBindingExportClassListFile] File renamed to ${targetFile.absolutePath}")
+            } else {
+                println("[processDataBindingExportClassListFile] Failed to rename file to out.jar")
+            }
+        } else {
+            println("[processDataBindingExportClassListFile] Directory must contain exactly one file; found ${filesInDir.size}")
+        }
+
+    }
